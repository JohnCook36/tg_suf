# Create a Telegram app at https://my.telegram.org/apps
# Do not share these credentials or the generated .session file.
TG_API_ID=
TG_API_HASH=
# Optional local data location:
# TG_SUF_DATA_DIR=C:/Users/you/AppData/Local/tg_suf

# Private Alice Dialogs skill (do not commit real values)
# Generate at least 32 random characters for webhook URL path.
ALICE_WEBHOOK_SECRET=
# Get this from the Alice Dialogs test request's session.user.user_id.
ALICE_ALLOWED_USER_ID=
# Alternative ONLY if session.user.user_id is unavailable (device-specific).
ALICE_ALLOWED_APPLICATION_ID=
